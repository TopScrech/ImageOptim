    "Makes files much smaller, but may change how images look" : {
      "comment" : "A description of the lossy minification feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقلل حجم الملفات كثيرًا، لكنه قد يغير مظهر الصور"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výrazně zmenší soubory, ale může změnit vzhled obrázků"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør filer meget mindre, men kan ændre billedernes udseende"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkleinert Dateien erheblich, kann aber das Aussehen der Bilder verändern"
