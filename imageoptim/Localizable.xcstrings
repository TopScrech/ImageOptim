    "It can take up to 30 minutes per image and may make your system unresponsive" : {
      "comment" : "A message displayed in a warning alert.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يستغرق الأمر ما يصل إلى 30 دقيقة لكل صورة وقد يجعل النظام غير مستجيب"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpracování jednoho obrázku může trvat až 30 minut a systém nemusí reagovat"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan tage op til 30 minutter pr. billede og kan få systemet til at holde op med at svare"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann bis zu 30 Minuten pro Bild dauern und dazu führen, dass das System nicht mehr reagiert"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορεί να χρειαστούν έως 30 λεπτά ανά εικόνα και το σύστημα ενδέχεται να μην αποκρίνεται"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
