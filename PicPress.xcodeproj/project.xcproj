  "targets": [
    {
      "name": "PicPress",
      "id": "8D1107260486CEB800E47090",
      "product": "Products/PicPress.app",
      "product-type": "application",
      "dependencies": [
        "downloads",
        "Backend",
        "ImageOptimize",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        {
          "kind": "copy",
          "name": "Copy Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "ScrechKit",
          "product-name": "ScrechKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CLANG_ENABLE_MODULES": "YES",
        "CLANG_ENABLE_OBJC_ARC": "YES",
        "CODE_SIGN_ENTITLEMENTS[config=Debug]": "PicPress/PicPress-Debug.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Release]": "PicPress/PicPress.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "COPY_PHASE_STRIP": "NO",
        "DEVELOPMENT_TEAM": "8FQUA2F388",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_FILE_ACCESS_DOWNLOADS_FOLDER": "readwrite",
        "ENABLE_HARDENED_RUNTIME": "NO",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "NO",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "NO",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "NO",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "FRAMEWORK_SEARCH_PATHS": [
          "$(inherited)",
          "$(BUILT_PRODUCTS_DIR)",
        ],
        "GCC_GENERATE_DEBUGGING_SYMBOLS": "YES",
        "GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS": "NO",
        "IMAGEOPTIM_APP_GROUP": "$(TeamIdentifierPrefix)net.pornel.ImageOptim",
        "INFOPLIST_FILE": "PicPress/Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "LM_FILTER_WARNINGS": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.topscrech.PicPress",
        "PRODUCT_NAME": "PicPress",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "REGISTER_APP_GROUPS": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "downloads",
      "id": "5A453F8D16BE79A7002AFE23",
      "kind": "external-build-system",
      "build-settings": {
        "CLANG_WARN_COMMA": "NO",
        "CLANG_WARN_STRICT_PROTOTYPES": "NO",
        "GCC_C_LANGUAGE_STANDARD": "gnu11",
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "WARNING_CFLAGS": [
          "-Wall",
          "-Wno-deprecated-non-prototype",
