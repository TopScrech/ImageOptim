        "COPY_PHASE_STRIP": "NO",
        "CURRENT_PROJECT_VERSION": "3",
        "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
        "DEFINES_MODULE": "YES",
        "DEVELOPMENT_TEAM": "",
        "DYLIB_COMPATIBILITY_VERSION": "1",
