        "DYLIB_INSTALL_NAME_BASE": "@rpath",
        "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
        "ENABLE_STRICT_OBJC_MSGSEND": "YES",
        "FRAMEWORK_VERSION": "A",
        "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
          "DEBUG=1",
          "$(inherited)",
        ],
        "GCC_WARN_64_TO_32_BIT_CONVERSION[config=Release]": "YES",
        "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
        "GCC_WARN_UNDECLARED_SELECTOR": "YES",
        "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
        "GCC_WARN_UNUSED_FUNCTION": "YES",
        "GCC_WARN_UNUSED_VARIABLE": "YES",
        "INFOPLIST_FILE": "PicPress/Backend/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@loader_path/Frameworks",
        ],
        "LM_FILTER_WARNINGS": "YES",
        "LM_SKIP_METADATA_EXTRACTION": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "MTL_ENABLE_DEBUG_INFO[config=Debug]": "YES",
        "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
        "PRODUCT_BUNDLE_IDENTIFIER": "net.pornel.ImageOptim.Backend",
        "PRODUCT_NAME": "ImageOptimGPL",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SKIP_INSTALL": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "VERSIONING_SYSTEM[config=Debug]": "apple-generic",
        "VERSION_INFO_PREFIX": "",
      },
