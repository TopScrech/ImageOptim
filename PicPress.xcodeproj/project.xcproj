    }, {
      "name": "svgcleaner-bin",
      "id": "01A0EFC243719EDFE6CE15E4",
      "product": "Products/svgcleaner",
      "product-type": "tool",
      "build-phases": [
        "compile-sources",
        {
          "kind": "script",
          "name": "Universal Binary lipo",
          "log-environment-variables": true,
          "input-paths": [
            "$(DERIVED_FILE_DIR)/$(ARCHS)-$(EXECUTABLE_NAME).xcfilelist",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(EXECUTABLE_PATH)",
          ],
          "shell": "/bin/sh",
          "script": [
            "# generated with cargo-xcode 1.7.0",
            "set -eux;",
            "tr '\\n' '\\0' < \"$DERIVED_FILE_DIR/$ARCHS-$EXECUTABLE_NAME.xcfilelist\" | xargs -0 lipo -create -output \"$TARGET_BUILD_DIR/$EXECUTABLE_PATH\"",
            "if [ ${LD_DYLIB_INSTALL_NAME:+1} ]; then",
            "  install_name_tool -id \"$LD_DYLIB_INSTALL_NAME\" \"$TARGET_BUILD_DIR/$EXECUTABLE_PATH\"",
            "fi",
            "",
          ],
        },
      ],
      "build-rules": [
        {
          "name": "Cargo project build",
          "processor": "com.apple.compilers.proxy.script",
          "file-type": "pattern.proxy",
          "file-patterns": "*/Cargo.toml",
          "output-files": [
            "$(OBJECT_FILE_DIR)/$(CARGO_XCODE_TARGET_ARCH)-$(EXECUTABLE_NAME)",
          ],
          "dependency-file": "$(DERIVED_FILE_DIR)/$(CARGO_XCODE_TARGET_ARCH)-$(EXECUTABLE_NAME).d",
          "script": [
            "# generated with cargo-xcode 1.7.0",
            "set -eu;",
            "export PATH=\"$HOME/.cargo/bin:$PATH:/usr/local/bin:/opt/homebrew/bin\";",
            "",
            "if [ \"${IS_MACCATALYST-NO}\" = YES ]; then",
            " CARGO_XCODE_TARGET_OS=ios-macabi",
            "fi",
            "CARGO_XCODE_TARGET_TRIPLE=\"${CARGO_XCODE_TARGET_ARCH}-apple-${CARGO_XCODE_TARGET_OS}\"",
            "if [ \"$CARGO_XCODE_TARGET_OS\" != darwin ]; then",
            " export PATH=\"${PATH/\\/Contents\\/Developer\\/Toolchains\\/XcodeDefault.xctoolchain\\/usr\\/bin:/xcode-provided-ld-cant-link-lSystem-for-the-host-build-script:}\"",
            "fi",
            "if [ \"$CARGO_XCODE_BUILD_MODE\" == release ]; then",
            " OTHER_INPUT_FILE_FLAGS=\"${OTHER_INPUT_FILE_FLAGS} --release\"",
            "fi",
            "",
            "if [ \"$ACTION\" = clean ]; then",
            " cargo clean --verbose --manifest-path=\"$SCRIPT_INPUT_FILE\" ${OTHER_INPUT_FILE_FLAGS} --target=\"${CARGO_XCODE_TARGET_TRIPLE}\";",
            " rm -f \"$SCRIPT_OUTPUT_FILE_0\"",
            " exit 0",
            "fi",
            "cargo build --verbose --manifest-path=\"$SCRIPT_INPUT_FILE\" --features=\"${CARGO_XCODE_FEATURES:-}\" ${OTHER_INPUT_FILE_FLAGS} --target=\"${CARGO_XCODE_TARGET_TRIPLE}\" || {",
            " if command -v rustup &> /dev/null; then",
            "  if ! rustup target list --installed | grep -Eq \"${CARGO_XCODE_TARGET_TRIPLE}\"; then",
            "   echo >&2 \"warning: this build requires rustup toolchain for $CARGO_XCODE_TARGET_TRIPLE, but it isn't installed (will try rustup next)\"",
            "   rustup target add \"${CARGO_XCODE_TARGET_TRIPLE}\" || echo >&2 \"warning: can't install $CARGO_XCODE_TARGET_TRIPLE\"",
            "  fi",
            " fi",
            " echo >&2 \"error: cargo build failed\"; exit 1; }",
            "",
            "# it's too hard to explain Cargo's actual exe path to Xcode build graph, so hardlink to a known-good path instead",
            "BUILT_SRC=\"${CARGO_TARGET_DIR}/${CARGO_XCODE_TARGET_TRIPLE}/${CARGO_XCODE_BUILD_MODE}/${CARGO_XCODE_CARGO_FILE_NAME}\"",
            "ln -f -- \"$BUILT_SRC\" \"$SCRIPT_OUTPUT_FILE_0\" || { echo >&2 \"can't hardlink $BUILT_SRC to $SCRIPT_OUTPUT_FILE_0\"; exit 1; }",
            "",
            "# cargo generates a dep file, but for its own path, so append our rename to it",
            "DEP_FILE_SRC=\"${CARGO_TARGET_DIR}/${CARGO_XCODE_TARGET_TRIPLE}/${CARGO_XCODE_BUILD_MODE}/${CARGO_XCODE_CARGO_DEP_FILE_NAME}\"",
            "if [ -f \"$DEP_FILE_SRC\" ]; then",
            " DEP_FILE_DST=\"${DERIVED_FILE_DIR}/${CARGO_XCODE_TARGET_ARCH}-${EXECUTABLE_NAME}.d\"",
            " cp -f \"$DEP_FILE_SRC\" \"$DEP_FILE_DST\" || { echo >&2 \"can't copy $DEP_FILE_SRC to $DEP_FILE_DST\"; exit 1; }",
            "",
            " echo >> \"$DEP_FILE_DST\" \"${SCRIPT_OUTPUT_FILE_0/ /\\\\ /}: ${BUILT_SRC/ /\\\\ /}\"",
            "fi",
            "",
            "# lipo script needs to know all the platform-specific files that have been built",
            "# archs is in the file name, so that paths don't stay around after archs change",
            "# must match input for LipoScript",
            "FILE_LIST=\"${DERIVED_FILE_DIR}/${ARCHS}-${EXECUTABLE_NAME}.xcfilelist\"",
            "touch \"$FILE_LIST\"",
            "if ! grep -Eq \"$SCRIPT_OUTPUT_FILE_0\" \"$FILE_LIST\" ; then",
            " echo >> \"$FILE_LIST\" \"$SCRIPT_OUTPUT_FILE_0\"",
            "fi",
            "",
            "echo \"success: $ACTION of $SCRIPT_OUTPUT_FILE_0 for $CARGO_XCODE_TARGET_TRIPLE\"",
            "",
          ],
        },
      ],
      "build-settings": {
        "ALWAYS_SEARCH_USER_PATHS": "NO",
        "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "NO",
        "CARGO_FUTURE_INCOMPAT_REPORT_FREQUENCY": "never",
        "CARGO_TARGET_DIR": "$(PROJECT_TEMP_DIR)/cargo_target/svgcleaner",
        "CARGO_XCODE_BUILD_MODE[config=Debug]": "debug",
        "CARGO_XCODE_BUILD_MODE[config=Release]": "release",
        "CARGO_XCODE_BUILD_PROFILE[config=Debug]": "debug",
