{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Configurations/debug.xcconfig" },
    { "name": "Release", "file": "Configurations/release.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "ar",
      "be",
      "ca",
      "cs",
      "da",
      "de",
      "el",
      "en-GB",
      "es",
      "fi",
      "fr",
      "he",
      "hr",
      "hu",
      "is",
      "it",
      "ja",
      "ko",
      "lt",
      "nb",
      "nl",
      "no",
      "pl",
      "pt",
      "pt-BR",
      "pt_BR",
      "ro",
      "ru",
      "sk",
      "sl",
      "sv",
      "th",
      "tr",
      "uk",
      "vi",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/ScrechKit.git",
      "version": {
        "up-to-next-major-version": "1.0.15",
      },
    },
  ],
  "files": [
    { "path": "README.md" },
    { "path": "AGENTS.md" },
    {
      "kind": "folder",
      "path": "PicPress",
      "membership-exceptions": [
        {
          "target": "PicPress",
          "inclusions": [
            "App/FocusedValues+Optimization.swift",
            "App/FocusedValues+Settings.swift",
            "App/GetQueueCountCommand.swift",
            "App/OptimizationCommands.swift",
            "App/PicPressApp.swift",
            "App/PicPressController.swift",
            "App/SettingsCommands.swift",
            "App/WindowLevelHostView.swift",
            "App/WindowLevelView.swift",
            "InfoPlist.xcstrings",
            "Localizable.xcstrings",
            "Optimization/DirectoryScanner.swift",
            "Optimization/FilesController.swift",
            "Optimization/JobProxy.swift",
            "Optimization/OptimizationFileView.swift",
            "Optimization/OptimizationResult.swift",
            "Optimization/OptimizationStatusView.swift",
            "Optimization/OptimizationTableView.swift",
            "Optimization/OptimizationToolbar.swift",
            "Optimization/OptimizationVM.swift",
            "Optimization/OptimizationView.swift",
            "PicPress.icns",
            "PicPressVerbs.sdef",
            "Settings/GeneralSettingsView.swift",
            "Settings/QualitySettingsView.swift",
            "Settings/SettingsVM.swift",
            "Settings/SettingsView.swift",
            "Settings/ToolSettingsView.swift",
            "Shared/SharedPreferences.swift",
            "defaults.plist",
          ],
        }, {
          "target": "Backend",
          "inclusions": [
            "Backend/AsyncLimiter.swift",
            "Backend/BundleAnchor.swift",
            "Backend/File.swift",
            "Backend/FileOperations.swift",
            "Backend/FileType.swift",
            "Backend/Job.swift",
            "Backend/JobQueue.swift",
            "Backend/OptimizationSettings.swift",
            "Backend/ResultsDb.swift",
            "Backend/Workers/CommandWorker.swift",
            "Backend/Workers/Optimizer.swift",
          ],
        }, {
          "target": "BackendTests",
          "inclusions": [
            "Backend/Tests/BackendTests.swift",
            "Backend/Tests/unoptimized.png",
            "Optimization/DirectoryScanner.swift",
            "Tests/DirectoryScannerTests.swift",
          ],
        }, {
          "target": "ImageOptimize",
          "inclusions": [
            "ImageOptimize/ExtensionController.swift",
            "ImageOptimize/ExtensionStatusView.swift",
            "ImageOptimize/ExtensionVM.swift",
            "Localizable.xcstrings",
            "PicPress.icns",
            "Shared/SharedPreferences.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "scripts" },
