{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Configurations/debug.xcconfig" },
    { "name": "Release", "file": "Configurations/release.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "ar",
      "be",
      "ca",
      "cs",
      "da",
      "de",
      "el",
      "en-GB",
      "es",
      "fi",
      "fr",
      "he",
      "hr",
      "hu",
      "is",
      "it",
      "ja",
      "ko",
      "lt",
      "nb",
      "nl",
      "no",
      "pl",
      "pt",
      "pt-BR",
      "pt_BR",
      "ro",
      "ru",
      "sk",
      "sl",
      "sv",
      "th",
      "tr",
      "uk",
      "vi",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/ScrechKit.git",
      "version": {
        "up-to-next-major-version": "1.0.15",
      },
    },
  ],
  "files": [
    { "path": "README.md" },
    { "path": "AGENTS.md" },
    {
      "kind": "folder",
      "path": "PicPress",
      "membership-exceptions": [
        {
          "target": "PicPress",
          "inclusions": [
            "App/FocusedValues+Optimization.swift",
            "App/FocusedValues+Settings.swift",
            "App/GetQueueCountCommand.swift",
            "App/OptimizationCommands.swift",
            "App/PicPressApp.swift",
            "App/PicPressController.swift",
            "App/SettingsCommands.swift",
            "App/WindowLevelHostView.swift",
            "App/WindowLevelView.swift",
            "InfoPlist.xcstrings",
            "Localizable.xcstrings",
            "Optimization/DirectoryScanner.swift",
            "Optimization/FilesController.swift",
            "Optimization/JobProxy.swift",
            "Optimization/OptimizationFileView.swift",
            "Optimization/OptimizationResult.swift",
            "Optimization/OptimizationStatusView.swift",
            "Optimization/OptimizationTableView.swift",
            "Optimization/OptimizationToolbar.swift",
            "Optimization/OptimizationVM.swift",
            "Optimization/OptimizationView.swift",
            "PicPress.icns",
            "PicPressVerbs.sdef",
            "Settings/GeneralSettingsView.swift",
            "Settings/QualitySettingsView.swift",
            "Settings/SettingsVM.swift",
            "Settings/SettingsView.swift",
            "Settings/ToolSettingsView.swift",
            "Shared/SharedPreferences.swift",
            "defaults.plist",
          ],
        }, {
          "target": "Backend",
          "inclusions": [
            "Backend/AsyncLimiter.swift",
            "Backend/BundleAnchor.swift",
            "Backend/File.swift",
            "Backend/FileOperations.swift",
            "Backend/FileType.swift",
            "Backend/Job.swift",
            "Backend/JobQueue.swift",
            "Backend/OptimizationSettings.swift",
            "Backend/ResultsDb.swift",
            "Backend/Workers/CommandWorker.swift",
            "Backend/Workers/Optimizer.swift",
          ],
        }, {
          "target": "BackendTests",
          "inclusions": [
            "Backend/Tests/BackendTests.swift",
            "Backend/Tests/unoptimized.png",
            "Optimization/DirectoryScanner.swift",
            "Tests/DirectoryScannerTests.swift",
          ],
        }, {
          "target": "ImageOptimize",
          "inclusions": [
            "ImageOptimize/ExtensionController.swift",
            "ImageOptimize/ExtensionStatusView.swift",
            "ImageOptimize/ExtensionVM.swift",
            "Localizable.xcstrings",
            "PicPress.icns",
            "Shared/SharedPreferences.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "scripts" },
    { "kind": "folder", "path": "Tools" },
    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/AppKit.framework", "target-membership": [ "Backend/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/Foundation.framework", "target-membership": [ "Backend/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/Quartz.framework", "target-membership": [ "PicPress/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/BackendTests.xctest", "id": "5ABE154C1AE5072300861C6B", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/PicPress.app", "id": "8D1107320486CEB800E47090", "type": "wrapper.application", "index": false },
        {
          "path": "<PRODUCTS>/ImageOptimGPL.framework",
          "id": "5ABE15421AE5072300861C6B",
          "type": "wrapper.framework",
          "index": false,
          "target-membership": [
            { "build-phase": "PicPress/copy/Copy Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "PicPress/frameworks",
            "BackendTests/frameworks",
            "ImageOptimize/frameworks",
          ],
        },
        { "path": "<PRODUCTS>/ImageOptimize.appex", "id": "5AC64EFE1AF3FDEE0032AA7F", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "PicPress/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    }, {
      "kind": "group",
      "name": "Configurations",
      "children": [
        { "path": "<PROJECT>/PicPress/debug.xcconfig", "encoding": "utf8" },
        { "path": "<PROJECT>/PicPress/release.xcconfig", "encoding": "utf8" },
      ],
    },
  ],
  "targets": [
    {
      "name": "PicPress",
      "id": "8D1107260486CEB800E47090",
      "product": "Products/PicPress.app",
      "product-type": "application",
      "dependencies": [
        "Backend",
        "ImageOptimize",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        {
          "kind": "copy",
          "name": "Copy Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "ScrechKit",
          "product-name": "ScrechKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CLANG_ENABLE_MODULES": "YES",
        "CLANG_ENABLE_OBJC_ARC": "YES",
        "CODE_SIGN_ENTITLEMENTS[config=Debug]": "PicPress/PicPress-Debug.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Release]": "PicPress/PicPress.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "COPY_PHASE_STRIP": "NO",
        "DEVELOPMENT_TEAM": "8FQUA2F388",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_FILE_ACCESS_DOWNLOADS_FOLDER": "readwrite",
        "ENABLE_HARDENED_RUNTIME": "NO",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "NO",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "NO",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "NO",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "FRAMEWORK_SEARCH_PATHS": [
          "$(inherited)",
          "$(BUILT_PRODUCTS_DIR)",
        ],
        "GCC_GENERATE_DEBUGGING_SYMBOLS": "YES",
        "GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS": "NO",
        "IMAGEOPTIM_APP_GROUP": "$(TeamIdentifierPrefix)net.pornel.ImageOptim",
        "INFOPLIST_FILE": "PicPress/Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "LM_FILTER_WARNINGS": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.topscrech.PicPress",
        "PRODUCT_NAME": "PicPress",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "REGISTER_APP_GROUPS": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "Backend",
      "id": "5ABE15411AE5072300861C6B",
      "product": "Products/ImageOptimGPL.framework",
